# Ticketing system. Leave ZENDESK_SUBDOMAIN unset to use the local sandbox (uv run soa-sandbox).
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=agent@example.com
ZENDESK_API_TOKEN=change-me
ZENDESK_WEBHOOK_SECRET=change-me-too

# Where the agent app listens and where the sandbox sends webhooks.
SOA_BASE_URL=http://127.0.0.1:8020
SOA_SANDBOX_URL=http://127.0.0.1:8021

# Slack incoming webhook for escalations. Unset = escalations are recorded but not sent.
SLACK_WEBHOOK_URL=

# Optional: enables the LLM planner. Without it the deterministic planner runs.
ANTHROPIC_API_KEY=

# Set to 1 to refuse all outbound HTTP (outbox rows stay pending).
SOA_OFFLINE=
